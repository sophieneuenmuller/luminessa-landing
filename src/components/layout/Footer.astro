---
import { site } from '../../site.config';

const { tagline, links } = site.footer;
---

<footer class="w-full border-t border-border bg-parchment mt-16">
  <div class="max-w-4xl mx-auto px-4 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">

    <p class="font-body text-ink-soft text-sm">{tagline}</p>

    <ul class="flex items-center gap-4 flex-wrap justify-center">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="font-body text-sm text-ink-soft hover:text-gold transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

  </div>
</footer>
